{
    "name": "diesis/wp-jwt-auth",
    "description": "Validate Cloudflare Access JWTs at a WordPress origin for selected paths.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev": {
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
        "php-stubs/wordpress-stubs": "^6.8 || ^7.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.2"
    },
    "autoload": {
        "psr-4": {
            "Diesis\\WpJwtAuth\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Diesis\\WpJwtAuth\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "phpcs",
        "test": "phpunit"
    }
}
