#: diesis-jwt-auth.php:40
msgid "DIESIS JWT Auth for Cloudflare Access is incomplete. Reinstall the release ZIP containing its dependencies."
msgstr "DIESIS JWT Auth for Cloudflare Access 不完整。请您重新安装包含其依赖项的发行版 ZIP。"

#. translators: Keep in English.
#: src/SettingsPage.php:102
msgid "Enforcement"
msgstr "Enforcement"

#: src/SettingsPage.php:137
msgid "Excluded paths"
msgstr "排除的路径"

#. translators: Keep in English.
#: src/SettingsPage.php:111
msgid "Issuer"
msgstr "Issuer"

#: src/SettingsPage.php:59
msgid "Issuer and audience are required before enforcement can be enabled."
msgstr "启用 Enforcement 之前必须填写 Issuer 和 Application audience。"

#: src/SettingsPage.php:133
msgid "One path per line. A trailing * matches a prefix. Query strings are ignored."
msgstr "每行一个路径。末尾的 * 匹配前缀。查询字符串会被忽略。"

#: src/SettingsPage.php:140
msgid "Only exclude a path if the matching Cloudflare Access destination also leaves it public."
msgstr "请您仅在对应的 Cloudflare Access 目标也将其保持公开时，才排除该路径。"

#: src/SettingsPage.php:126
msgid "Optional defense in depth. Enter one address per line. Leave empty to trust the Access policy."
msgstr "可选的额外防护。请您每行输入一个地址。留空即表示您信任 Access policy。"

#: src/SettingsPage.php:130
msgid "Protected paths"
msgstr "受保护的路径"

#: src/SettingsPage.php:106
msgid "Require a valid Access JWT on the configured paths"
msgstr "在已配置的路径上要求有效的 Access JWT"

#: src/SettingsPage.php:78
msgid "Settings"
msgstr "设置"

#: src/SettingsPage.php:58
msgid "The issuer must be an HTTPS cloudflareaccess.com URL."
msgstr "Issuer 必须是 cloudflareaccess.com 的 HTTPS URL。"

#: src/SettingsPage.php:96
msgid "Validates Cloudflare Access at the WordPress origin. This plugin does not replace the WordPress login."
msgstr "在 WordPress origin 验证 Cloudflare Access。本插件不替代 WordPress 登录。"
